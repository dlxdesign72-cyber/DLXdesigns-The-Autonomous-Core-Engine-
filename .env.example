# Environment variables (example)
# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=public-anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# Gemini / Generative AI (server only)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_BASE_URL=https://generativeapi.example.com/v1
GEMINI_MODEL=text-bison-001

# App
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# Internal protection for server endpoints (keep secret)
INTERNAL_API_SECRET=replace_with_secure_random_value

# Optional: set to limit hunter runtime when running locally
HUNTER_MAX_PAGES=5

# Notification providers (optional, not used for automated outreach)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
OWNER_PHONE=
